{
  "properties": {
    "id": { "type": "keyword" },
    "orderId": { "type": "keyword" },
    "userId": { "type": "keyword" },
    "hotelId": { "type": "keyword" },
    "tripId": { "type": "keyword" },
    "status": { "type": "integer" },
    "totalAmount": { "type": "scaled_float", "scaling_factor": 100 },
    "createdTime": { "type": "date", "format": "yyyy-MM-dd'T'HH:mm:ss" },
    "updatedTime": { "type": "date", "format": "yyyy-MM-dd'T'HH:mm:ss" },
    "items": {
      "type": "nested",
      "properties": {
        "itemId": { "type": "keyword" },
        "productId": { "type": "keyword" },
        "specId": { "type": "keyword" },
        "productName": { "type": "text", "analyzer": "ik_max_word", "search_analyzer": "ik_smart" },
        "specName": { "type": "keyword" },
        "quantity": { "type": "integer" },
        "price": { "type": "scaled_float", "scaling_factor": 100 }
      }
    }
  }
}
